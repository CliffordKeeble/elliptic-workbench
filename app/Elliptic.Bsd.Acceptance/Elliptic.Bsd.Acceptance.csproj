<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Elliptic.Bsd/Elliptic.Bsd.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- archived LMFDB source evidence + manifest, integrity-checked at runtime -->
    <Content Include="lmfdb\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
