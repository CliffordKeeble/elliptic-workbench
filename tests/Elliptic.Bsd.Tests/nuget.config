<?xml version="1.0" encoding="utf-8"?>
<!-- The test project alone needs nuget.org (for xUnit). This folder-level config
     re-enables it here only; the repo-root nuget.config still clears all sources,
     so Elliptic.Bsd / Elliptic.Numerics stay dependency-free and build offline. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
